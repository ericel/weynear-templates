{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.weynear.com/automations/manifest-v1.json",
  "title": "Weynear automation installation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {
      "const": "automations.weynear.com/v1"
    },
    "kind": {
      "const": "Automation"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display_name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "bot",
        "configuration",
        "destinations",
        "triggers",
        "connections",
        "permissions",
        "limits"
      ],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "version", "entrypoint"],
          "properties": {
            "language": {
              "const": "python"
            },
            "version": {
              "const": "3.12"
            },
            "entrypoint": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        "bot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bot_id"],
          "properties": {
            "bot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "integer", "boolean"]
          }
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "type": {
                "enum": ["posts", "messages"]
              },
              "visibility": {
                "type": "string"
              },
              "reply_policy": {
                "enum": ["everyone", "followers", "none"]
              },
              "audience_id": {
                "type": "string"
              },
              "message_class": {
                "enum": ["transactional", "service", "marketing"]
              }
            }
          }
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "type"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "type": {
                "enum": ["manual", "schedule", "provider_webhook", "platform_event"]
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "type"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "type": {
                "enum": ["https_api", "rss", "provider_webhook"]
              }
            }
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    }
  }
}
