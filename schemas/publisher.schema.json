{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.weynear.com/automations/publisher-v1.json",
  "title": "Weynear automation publisher",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {
      "const": "registry.automations.weynear.com/v1"
    },
    "kind": {
      "const": "Publisher"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "display_name"],
      "properties": {
        "publisher": {
          "$ref": "#/$defs/identifier"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github",
        "artifact_registry",
        "builders",
        "signing",
        "required_attestations"
      ],
      "properties": {
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "repositories"],
          "properties": {
            "owner": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,63}$"
            },
            "repositories": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://github\\.com/[a-z0-9_.-]+/[a-z0-9_.-]+$"
              }
            }
          }
        },
        "artifact_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_prefix"],
          "properties": {
            "repository_prefix": {
              "type": "string",
              "pattern": "^[a-z0-9-]+-docker\\.pkg\\.dev/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+/$"
            }
          }
        },
        "builders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://github\\.com/.+/.github/workflows/.+@refs/heads/main$"
          }
        },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "kms_key_resource"],
          "properties": {
            "algorithm": {
              "const": "ec-sign-p256-sha256"
            },
            "kms_key_resource": {
              "type": "string",
              "pattern": "^projects/[a-z0-9-]+/locations/[a-z0-9-]+/keyRings/[A-Za-z0-9_-]+/cryptoKeys/[A-Za-z0-9_-]+/cryptoKeyVersions/[1-9][0-9]*$"
            }
          }
        },
        "required_attestations": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "contains": {
            "const": "slsa-provenance-v1"
          },
          "items": {
            "enum": ["slsa-provenance-v1", "spdx-2.3"]
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    }
  }
}
